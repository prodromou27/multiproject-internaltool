# PRODUCTION environment — copy to the repo-root .env on the PROD machine:
#   cp deploy/env.prod.example .env   (then fill in STRONG, unique secrets)
#
# Generate secrets (do NOT reuse the DEV values):
#   POSTGRES_PASSWORD : openssl rand -hex 24
#   JWT_SECRET        : openssl rand -hex 48     (must be >= 32 chars)
#   CUSTOMER_FIELD_KEY: openssl rand -hex 32     (exactly 64 hex chars)
#   ATTACHMENT_KEY    : openssl rand -hex 32     (exactly 64 hex chars)
#
# IMPORTANT: back up CUSTOMER_FIELD_KEY somewhere safe (a secrets manager).
# Losing it makes all encrypted customer PII permanently unrecoverable.

# ── Database (bundled Postgres container) ─────────────────────────────────────
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=CHANGE_ME_prod_db_password

# ── App secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_prod_jwt_secret_at_least_32_chars
CUSTOMER_FIELD_KEY=CHANGE_ME_64_hex_chars
ATTACHMENT_KEY=CHANGE_ME_64_hex_chars

# ── Networking ────────────────────────────────────────────────────────────────
# Host port the app is published on. Typically front this with a TLS reverse
# proxy (nginx/Caddy/Traefik) that terminates HTTPS and forwards to this port.
# Bind to localhost so only the proxy can reach it: APP_PORT=127.0.0.1:8080
APP_PORT=127.0.0.1:8080

# Public HTTPS URL used in password reset emails.
APP_URL=https://app.example.com

# Production updates must use the Docker/branch deployment pipeline.
ALLOW_IN_APP_UPDATES=false

# Trust N reverse-proxy hops so the real client IP (audit log, rate limiting)
# comes from X-Forwarded-For. Set to 1 when behind the nginx/Caddy config in
# deploy/nginx.conf.example. Leave unset if the app is exposed directly.
TRUST_PROXY=1

# First empty-database login: admin / admin. A password change is then required.
ADMIN_PASSWORD=admin
