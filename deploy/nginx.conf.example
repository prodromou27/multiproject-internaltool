# Production TLS reverse proxy for the app (terminates HTTPS, forwards to the
# container on 127.0.0.1:8080). Install on the PROD host:
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/conf.d/solutionshub.conf
#   # edit server_name + cert paths, then:
#   sudo nginx -t && sudo systemctl reload nginx
#
# Pair this with APP_PORT=127.0.0.1:8080 and TRUST_PROXY=1 in .env so the app
# only listens on localhost and reads the real client IP from X-Forwarded-For.
#
# TLS certs: use certbot (Let's Encrypt) —
#   sudo dnf install -y certbot python3-certbot-nginx
#   sudo certbot --nginx -d app.example.com
# certbot will manage the ssl_certificate lines for you.

# Redirect all HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;          # ← change me
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.com;          # ← change me

    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;   # ← change me
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;     # ← change me
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Allow large Excel/attachment uploads (app caps attachments at 20 MB).
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# ── Simpler alternative: Caddy (auto-HTTPS) ──────────────────────────────────
# A whole Caddyfile equivalent is just:
#
#   app.example.com {
#       reverse_proxy 127.0.0.1:8080
#       request_body { max_size 25MB }
#   }
#
# Caddy obtains and renews Let's Encrypt certs automatically.
