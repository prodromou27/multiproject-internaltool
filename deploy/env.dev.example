# DEV environment — copy to the repo-root .env on the DEV machine:
#   cp deploy/env.dev.example .env   (then fill in the secrets below)
#
# Generate secrets:
#   POSTGRES_PASSWORD : openssl rand -hex 24
#   JWT_SECRET        : openssl rand -hex 48     (must be >= 32 chars)
#   CUSTOMER_FIELD_KEY: openssl rand -hex 32     (exactly 64 hex chars)

# ── Database (bundled Postgres container) ─────────────────────────────────────
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=CHANGE_ME_dev_db_password

# ── App secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_dev_jwt_secret_at_least_32_chars
CUSTOMER_FIELD_KEY=CHANGE_ME_64_hex_chars_or_leave_blank_to_disable_encryption

# ── Networking ────────────────────────────────────────────────────────────────
# Host port the app is published on (container always listens on 8080).
APP_PORT=8080

# Optional: set the first-run admin password (otherwise a random one is printed
# once to the app logs on first startup).
# ADMIN_PASSWORD=
