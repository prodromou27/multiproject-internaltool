# Normalize line endings. Files that run on Linux MUST stay LF even when the repo
# is edited/committed from Windows, or bash/docker fail with "bad interpreter ^M".
* text=auto

*.sh           text eol=lf
Dockerfile     text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
.env.example   text eol=lf
deploy/env.*.example text eol=lf
