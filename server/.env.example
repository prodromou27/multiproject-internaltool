# SolutionsHub server environment — copy to .env and fill in real values.
# The real .env is gitignored; this template is safe to commit.

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Postgres connection string. Required. In docker-compose this is injected
# automatically (postgres://app:...@db:5432/app). For a local non-Docker run,
# point it at your own Postgres instance.
DATABASE_URL=postgres://app:devsecret@localhost:5432/app

# ── Customer PII field encryption (AES-256-GCM, 256-bit key) ──────────────────
# 64-char hex string. Required for customer contact fields to be encrypted at rest.
# WARNING: back this up securely — losing it makes all encrypted customer data
# permanently unrecoverable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_FIELD_KEY=

# ── Attachment encryption (AES-256-GCM, 256-bit key) ──────────────────────────
# 64-char hex string. Required in production for uploaded files to be encrypted
# at rest. Back this up securely with CUSTOMER_FIELD_KEY.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTACHMENT_KEY=

# ── JWT signing secret ───────────────────────────────────────────────────────
# Must be at least 32 chars. In production the server refuses to start without it.
# Without it in dev, a random per-process secret is used and every restart logs
# everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# NODE_ENV=production
# APP_URL=http://localhost:8080              # public base URL for reset links
# ALLOWED_ORIGIN=http://localhost:5173   # only for split client/server dev
# ALLOW_IN_APP_UPDATES=false             # keep false in production; use Docker deploys
# PORT=8080                              # HTTP port (used when no TLS certs present;
#                                        # the Docker image listens here behind a proxy)
# HTTPS_PORT=443                         # only when TLS certs are mounted (non-Docker)
# HTTP_PORT=80
