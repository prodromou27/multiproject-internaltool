# SolutionsHub server environment — copy to .env and fill in real values.
# The real .env is gitignored; this template is safe to commit.

# ── Customer PII field encryption (AES-256-GCM, 256-bit key) ──────────────────
# 64-char hex string. Required for customer contact fields to be encrypted at rest.
# WARNING: back this up securely — losing it makes all encrypted customer data
# permanently unrecoverable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_FIELD_KEY=

# ── JWT signing secret ───────────────────────────────────────────────────────
# Must be at least 32 chars. In production the server refuses to start without it.
# Without it in dev, a random per-process secret is used and every restart logs
# everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# NODE_ENV=production
# ALLOWED_ORIGIN=http://localhost:5173   # only for split client/server dev
# HTTPS_PORT=443
# HTTP_PORT=80
# PORT=3001                              # used only when no TLS certs are present
